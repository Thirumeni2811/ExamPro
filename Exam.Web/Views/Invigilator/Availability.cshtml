@model Exam.Web.ViewModels.InvigilatorAvViewModel

@{
    ViewData["Title"] = "Set Availability";
    Layout = "User";

    var today = DateTime.Today;
    var daysLeft = DayOfWeek.Saturday - today.DayOfWeek; 
    if (daysLeft < 0) daysLeft = 0; 
    var weekEnd = today.AddDays(daysLeft);
}

@section Styles {
    <link rel="stylesheet" href="~/css/inv.css" />
}

<section class="availability-container">

    <div class="avvv1">
      
        <div class="av2">
            <h2>Your Recent Activities</h2>

            @if (Model.Notifications.Any())
            {
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (item, index) in Model.Notifications
                                            .OrderByDescending(n => n.CreatedAt)
                                            .Take(10)
                                            .Select((value, i) => (value, i + 1)))
                        {
                            <tr>
                                <td>@item.CreatedAt.ToLocalTime().ToString("MMM dd yyyy - hh:mm tt")</td>
                                <td>@item.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.Notifications.Count() > 10)
                {
                    <p class="text-muted">Showing the 10 most recent activities.</p>
                }
            }
            else
            {
                <p class="no-data">No recent activities available.</p>
            }
        </div>

        <div class="av1">
            <h2>Your Availability</h2>

            @if (Model.Availabilities.Any())
            {
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Day</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Availabilities.OrderBy(a => a.Date).Take(10))
                        {
                            <tr>
                                <td>@item.Date.ToString("dd MMM yyyy")</td>
                                <td>@item.DayOfWeek</td>
                                <td>
                                    <form asp-action="Delete" asp-controller="Invigilator" asp-route-id="@item.Id"
                                          method="post" style="display:inline;"
                                          onsubmit="return confirm('Are you sure you want to delete this availability?');">
                                        <button type="submit" style="border:none; background:none; padding:0; cursor:pointer;">
                                            <img src="@Url.Content("~/images/Delete.svg")" alt="Delete" class="action-image" />
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Model.Availabilities.Count() > 10)
                {
                    <p class="text-muted">Showing only the first 10 availabilities.</p>
                }
            }
            else
            {
                <p class="no-data">No availability submitted yet. Please add your available date.</p>
            }

        </div>

    </div>

    <div class="avvv2">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="error">@TempData["ErrorMessage"]</div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success">@TempData["SuccessMessage"]</div>
        }
        <h2>Select Your Available Date</h2>

        <form asp-action="AddAvailability" asp-controller="Invigilator" method="post">
            <div class="calendar-container">
                <input type="date" name="selectedDate"
                       min="@today.ToString("yyyy-MM-dd")"
                       max="@weekEnd.ToString("yyyy-MM-dd")"
                       class="date-picker" required />
            </div>

            <button type="submit" class="btn-submit">Add Availability</button>
        </form>

    </div>
    
</section>

    
