@model Exam.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "User Login";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/form.css" />
}

<form asp-action="UserLogin" asp-controller="Account" method="post" class="form-container">
    @Html.AntiForgeryToken()

    <div class="heading">Welcome!</div>
    <div class="subheading">Enter your Login Details</div>

    <div class="form-grid">
        @if (!ViewData.ModelState.IsValid)
        {
            foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div class="danger">@error.ErrorMessage</div>
            }
        }

        <div class="form-group">
            <label asp-for="Email">Email Address</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="danger"></span>
        </div>

    </div>

    <div class="btnn">
        <button type="submit">Login</button>
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
