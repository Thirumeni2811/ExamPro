@model List<Exam.Domain.Models.Allocation>

@{
    ViewData["Title"] = "Allocations";
    Layout = "~/Views/Shared/Admin.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

<section>

    <div class="table-container">
        <div class="filters">
            <form method="get" asp-controller="Admin" asp-action="Allocation" class="search-form1">
                <input type="text" name="venueName" placeholder="Venue Name" value="@ViewBag.VenueName" />
                <input type="text" name="hallNumber" placeholder="Hall Number" value="@ViewBag.HallNumber" />
                <input type="text" name="invigilatorName" placeholder="Invigilator Name" value="@ViewBag.InvigilatorName" />
                <input type="date" name="date" value="@ViewBag.Date" />

                <select name="status">
                    <option value="">Status</option>
                    @foreach (var status in Enum.GetValues(typeof(Exam.Domain.Enums.AllocationStatus)))
                    {
                        <option value="@status" selected="@(ViewBag.Status?.ToString() == status.ToString() ? "selected" : null)">
                            @status
                        </option>
                    }
                </select>

                <div class="buttons1">
                    @* submit *@
                    <button type="submit" class="submit">
                        <img src="@Url.Content("~/images/Search.svg")" alt="Search" />
                        Search
                    </button>

                    @* reset *@
                    <a asp-controller="Admin" asp-action="Allocation" class="reset">
                        <img src="@Url.Content("~/images/Reset.svg")" alt="Search" />
                        Reset
                    </a>
                </div>

            </form>

        </div>

        <div class="tabless">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Venue Name</th>
                        <th>Hall Number</th>
                        <th>Capacity</th>
                        <th>Invigilator</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var allocations = ViewBag.AllocationList as List<Exam.Domain.Models.Allocation>;
                    }

                    @if (allocations.Any())
                    {
                        var index = 1;
                        foreach (var allocation in allocations)
                        {
                            <tr>
                                <td>@index</td>
                                <td>@allocation.Venue?.Name</td>
                                <td>@allocation.Venue?.HallNumber</td>
                                <td>@allocation.Venue?.Capacity</td>
                                <td>@allocation.Invigilator?.Name</td>
                                <td>@allocation.Date.ToString("dd-MMMM-yyyy (dddd)")</td>
                                <td>@allocation.Status</td>
                                <td>
                                    <form asp-action="DeleteAllocation" asp-controller="Admin" asp-route-id="@allocation.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this allocation?');">
                                        <button type="submit" style="border:none; background:none; padding:0; cursor:pointer;">
                                            <img src="@Url.Content("~/images/Delete.svg")" alt="Delete" class="action-image" />
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="no-data">No allocations found.</td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}
